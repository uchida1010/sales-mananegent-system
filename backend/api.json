                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "user_code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "roles": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 0,
                                "maxItems": 0,
                                "additionalItems": false
                            }
                        ]
                    }
                },
                "required": [
                    "id",
                    "user_code",
                    "name",
                    "email",
                    "status",
                    "roles"
                ],
                "title": "UserResource"
            }
        },
