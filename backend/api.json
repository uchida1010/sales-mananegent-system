                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/UserResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            },
            "post": {
                "operationId": "user.store",
                "summary": "Store a newly created resource in storage",
                "tags": [
                    "User"
                ],
                "responses": {
                    "200": {
                        "description": ""
                    }
                }
            }
